# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Database (local SQLite — re-created on first run)
*.db
*.sqlite3

# Data cache (downloaded datasets — re-downloadable)
data/cache/
data/*.csv
data/*.parquet
!data/.gitkeep

# Artifacts / reports (generated at runtime)
artifacts/*
!artifacts/.gitkeep

# Generated HTML/JSON reports
reports/*.html
reports/*.json

# OS
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# MLflow
mlruns/

# Distribution
dist/
build/
*.egg-info/

# Streamlit (legacy — replaced by FastAPI + HTML/CSS/JS)
.streamlit/

# Unzipped repo archive
Evidence-Driven-Automated-Auditing-and-Repair-of-Machine-Learning-Evaluation-Pipelines-main/
.oxlintrc.json

# Universal ML Studio runtime files
universal_ml_studio/storage/datasets/*
!universal_ml_studio/storage/datasets/.gitkeep
universal_ml_studio/storage/models/*
!universal_ml_studio/storage/models/.gitkeep
universal_ml_studio/storage/reports/*
!universal_ml_studio/storage/reports/.gitkeep
universal_ml_studio/storage/*.db*
universal_ml_studio/storage/_temp/
.agents/
